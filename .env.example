NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Optional: model intake, report prose, and per-slide OCR on image-only PDF pages (OpenRouter).
OPENROUTER_API_KEY=
# Self-hosted Supabase on Railway: set this instead of the two keys above and
# they are derived from it (see lib/supabase/root-secret.ts).
SUPABASE_ROOT_SECRET=
# Used by `npm run db:migrate` (Railway pre-deploy) to apply supabase/migrations.
DATABASE_URL=
